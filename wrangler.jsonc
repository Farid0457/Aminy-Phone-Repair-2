{
  // Cloudflare Worker + static assets. See docs/architecture.md and docs/decisions.md (D-01, D-02).
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "aminy-phone-repair-2",
  "main": "src/worker.js",
  "compatibility_date": "2026-11-01",

  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "not_found_handling": "404-page",
    // API routes always reach the Worker; everything else is served straight from public/
    "run_worker_first": ["/api/*"]
  },

  "observability": { "enabled": true },

  // D1 database (D-13). database_id is a placeholder until step B4 runs
  // `npx wrangler d1 create aminy-db` — local dev doesn't need a real one.
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "aminy-db",
      "database_id": "80b99810-b5ab-4bb1-8bee-782abb120fd8",
      "migrations_dir": "migrations"
    }
  ],

  "vars": {
    // log | resend | cloudflare  (D-02). "log" prints emails to the console — local/dev only.
    "EMAIL_PROVIDER": "log",
    "MAIL_FROM": "",
    "MAIL_TO": "",
    "ALLOWED_ORIGINS": "https://aminyrepair.com.au,https://www.aminyrepair.com.au"
  }
}
