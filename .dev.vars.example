# Local secrets for `npm run dev` (wrangler dev).
# Copy this file to .dev.vars — .dev.vars is git-ignored. Never commit real keys.
# Production secrets are set with: npx wrangler secret put <NAME>

# Cloudflare Turnstile TEST secret — always passes. Real key: docs/manual/03-cloudflare-setup.md §5
TURNSTILE_SECRET_KEY=1x0000000000000000000000000000000AA

# Only needed when EMAIL_PROVIDER=resend. Real key: docs/manual/03-cloudflare-setup.md §6
# RESEND_API_KEY=

# Admin API (task 2.7): skip the Cloudflare Access token check on localhost ONLY.
# The Worker ignores this on any other host. Never set it in production.
ADMIN_DEV_BYPASS=true
